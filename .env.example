# Server Environment
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# PostgreSQL Database (Render PostgreSQL or Docker)
DATABASE_URL=postgresql://health_user:health_password@localhost:5432/health_companion_dev?schema=public

# Redis Queue & Cache (Render Key Value or Docker)
REDIS_URL=redis://localhost:6379

# JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=c8e76f4e1f727b14d9b4c09efbf3a07b66df8cf8db078e63a8a927fa1e57c123
JWT_REFRESH_SECRET=b10787a4128f6e80ce994e45c71b7fcf7c71e2170362c1e7a5c8e31245781290
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Field-Level Encryption Key (Must be 32 bytes hex - 64 hex characters)
# Generate with `openssl rand -hex 32`
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Web Push VAPID Keys (Generate with `npm run generate:vapid`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@dailyhealth.internal

# SMTP Email Settings (Optional, email notifications skip cleanly if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Daily Health Companion <noreply@dailyhealth.internal>

# AI Assistant Configuration (mock or provider API key)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
