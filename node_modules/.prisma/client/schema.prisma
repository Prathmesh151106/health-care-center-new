datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LogType {
  WATER
  SLEEP
  STEPS
  WEIGHT
  MOOD
  BLOOD_PRESSURE
  BLOOD_SUGAR
  SYMPTOM
  NOTE
}

enum GoalPeriod {
  DAILY
  WEEKLY
}

enum MedicineStatus {
  PENDING
  TAKEN
  SKIPPED
  MISSED
  SNOOZED
}

enum ReminderKind {
  MEDICINE
  WATER
  EXERCISE
  SLEEP
  APPOINTMENT
  CUSTOM
}

enum ReminderChannel {
  IN_APP
  PUSH
  EMAIL
}

enum AssistantRole {
  user
  assistant
  system
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  name                String
  dateOfBirth         DateTime? @map("date_of_birth")
  heightCm            Float?    @map("height_cm")
  timezone            String    @default("UTC")
  locale              String    @default("en")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime? @map("lockout_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  healthLogs          HealthLog[]
  goals               Goal[]
  medicines           Medicine[]
  reminders           Reminder[]
  pushSubscriptions   PushSubscription[]
  appointments        Appointment[]
  assistantMessages   AssistantMessage[]
  settings            UserSettings?
  auditLogs           AuditLog[]

  @@map("users")
}

model RefreshToken {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  tokenHash    String   @unique @map("token_hash")
  familyId     String   @map("family_id")
  isRevoked    Boolean  @default(false) @map("is_revoked")
  replacedById String?  @map("replaced_by_id")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  ipHash       String?  @map("ip_hash")
  userAgent    String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model HealthLog {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  type          LogType
  value         Json // Validated JSON metric
  unit          String?
  loggedAt      DateTime @default(now()) @map("logged_at")
  encryptedNote String?  @map("encrypted_note") // AES-256-GCM cipher payload
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@index([userId, type, loggedAt])
  @@map("health_logs")
}

model Goal {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  type        LogType
  targetValue Float      @map("target_value")
  period      GoalPeriod @default(DAILY)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enforce one active goal per type and period at DB constraint
  @@unique([userId, type, period, isActive], name: "unique_user_active_goal")
  @@index([userId])
  @@map("goals")
}

model Medicine {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  name           String
  dose           String
  form           String    @default("tablet")
  schedule       Json // { times: ["08:00", "20:00"], daysOfWeek?: [1,2,3,4,5] }
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  isActive       Boolean   @default(true) @map("is_active")
  encryptedNotes String?   @map("encrypted_notes")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    MedicineEvent[]
  reminders Reminder[]

  @@index([userId, isActive])
  @@map("medicines")
}

model MedicineEvent {
  id          String         @id @default(uuid())
  medicineId  String         @map("medicine_id")
  scheduledAt DateTime       @map("scheduled_at")
  status      MedicineStatus @default(PENDING)
  actedAt     DateTime?      @map("acted_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([medicineId, scheduledAt], name: "unique_medicine_scheduled_event")
  @@index([medicineId, scheduledAt])
  @@map("medicine_events")
}

model Reminder {
  id            String            @id @default(uuid())
  userId        String            @map("user_id")
  kind          ReminderKind
  title         String
  body          String?
  rrule         String // iCalendar RRULE format
  timezone      String            @default("UTC")
  nextFireAt    DateTime          @map("next_fire_at")
  lastFiredAt   DateTime?         @map("last_fired_at")
  channels      ReminderChannel[]
  isActive      Boolean           @default(true) @map("is_active")
  medicineId    String?           @map("medicine_id")
  appointmentId String?           @map("appointment_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicine    Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([nextFireAt, isActive])
  @@index([userId, isActive])
  @@map("reminders")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String // Encrypted or protected subscription key
  auth      String // Encrypted or protected subscription auth
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Appointment {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  title                 String
  doctor                String?
  location              String?
  scheduledAt           DateTime @map("scheduled_at")
  encryptedNotes        String?  @map("encrypted_notes")
  reminderOffsetMinutes Int?     @map("reminder_offset_minutes")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([userId, scheduledAt])
  @@map("appointments")
}

model AssistantMessage {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  role      AssistantRole
  content   String
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("assistant_messages")
}

model UserSettings {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  aiContextOptIn  Boolean  @default(false) @map("ai_context_opt_in")
  quietHoursStart String?  @map("quiet_hours_start") // "22:00"
  quietHoursEnd   String?  @map("quiet_hours_end") // "07:00"
  theme           String   @default("system")
  notifEmail      Boolean  @default(true) @map("notif_email")
  notifPush       Boolean  @default(true) @map("notif_push")
  notifInApp      Boolean  @default(true) @map("notif_in_app")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String // e.g. "AUTH_LOGIN_SUCCESS", "DATA_EXPORTED", "ACCOUNT_DELETED"
  metadata  Json? // Safe, allowlisted metadata ONLY (e.g. { ipHash, userAgent })
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
